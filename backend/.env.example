PORT=5000
# Local development
MONGO_URI=mongodb://localhost:27017/leadflow

# Docker (use this instead when running via docker-compose)
MONGO_URI=mongodb://mongo:27017/leadflow

JWT_SECRET=your_super_secret_jwt_key
SESSION_SECRET=your_session_secret
EMAIL_USER=your_email@gmail.com # For email verification thing using nodemailer
EMAIL_APP_PASSWORD=your_app_password # For email verification thing using nodemailer


